<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================= -->
    <!-- Base application theme – Material 3 Light with no action bar  -->
    <!-- ============================================================= -->
    <style name="Theme.SmartCareer" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/sc_primary</item>
        <item name="colorPrimaryDark">@color/sc_primary_dark</item>
        <item name="colorAccent">@color/sc_secondary</item>

        <!-- Surface & background -->
        <item name="android:colorBackground">@color/sc_background</item>
        <item name="colorSurface">@color/sc_surface</item>

        <!-- Status-bar styling (light background → dark icons) -->
        <item name="android:statusBarColor">@color/sc_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Error color for TextInputLayout -->
        <item name="colorError">@color/sc_error</item>
    </style>

</resources>