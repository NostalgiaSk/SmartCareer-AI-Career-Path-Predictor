<?xml version="1.0" encoding="utf-8"?>
<!-- Small outlined pill for the "Start Learning" button on certification cards -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <stroke
        android:width="1.5dp"
        android:color="@color/sc_primary" />

    <solid android:color="@android:color/transparent" />

    <corners android:radius="16dp" />

    <padding
        android:left="14dp"
        android:top="6dp"
        android:right="14dp"
        android:bottom="6dp" />
</shape>
