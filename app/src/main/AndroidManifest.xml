<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for OpenAI API calls via Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartCareer">

        <!-- Login screen – the first screen users see -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home dashboard (launched after successful login) -->
        <activity
            android:name=".activities.HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Main dashboard (launched after successful login) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Registration screen (launched from Login → Create Account) -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Career profile form (launched after login/register) -->
        <activity
            android:name=".activities.CareerProfileActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- AI career suggestions list (launched after profile submission) -->
        <activity
            android:name=".activities.CareerSuggestionsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Skill gap detail screen (launched from a career card) -->
        <activity
            android:name=".activities.SkillGapActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Certification detail screen (launched from dashboard) -->
        <activity
            android:name=".activities.CertificationDetailActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Saved careers full-screen list -->
        <activity
            android:name=".activities.SavedCareersActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Career detail screen (launched from saved careers) -->
        <activity
            android:name=".activities.CareerDetailActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Module content screen (launched from certification detail) -->
        <activity
            android:name=".activities.ModuleActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Quiz screen (launched from module screen) -->
        <activity
            android:name=".activities.QuizActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Certificate completion screen -->
        <activity
            android:name=".activities.CertificateActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Quiz result screen (pass/fail) -->
        <activity
            android:name=".activities.QuizResultActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Obtained certifications list -->
        <activity
            android:name=".activities.ObtainedCertificationsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Certification result detail -->
        <activity
            android:name=".activities.CertificationResultActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

    </application>

</manifest>