<?xml version="1.0" encoding="utf-8"?>

<!--
    REDESIGNED Home Dashboard layout — 2025 modern startup aesthetic.

    Design decisions:
    ▸ Full-width gradient hero header with rounded bottom (32dp)
    ▸ Featured "Top Career Match" card with white-on-gradient styling
    ▸ Quick actions in a horizontal scroll with generous 20dp radius cards
    ▸ Section titles use emoji icons for visual weight without extra drawables
    ▸ All cards have 20dp corner radius + soft 4dp elevation
    ▸ RecyclerViews use layout animations for cascading entry
    ▸ Generous spacing (24dp horizontal, 20dp+ vertical gaps)
-->

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sc_background"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".activities.HomeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ════════════════════════════════════════════════════════════
             SECTION 1 — Gradient Hero Header
             ════════════════════════════════════════════════════════════ -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- Welcome text — large, bold, white -->
            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                tools:text="Welcome back, Hanin 👋"
                app:layout_constraintEnd_toStartOf="@id/ivProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Profile icon — top-right -->
            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_score_badge"
                android:contentDescription="@string/home_profile_icon"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Motivational subtitle -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.85"
                android:fontFamily="sans-serif"
                android:text="@string/home_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvWelcome" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ════════════════════════════════════════════════════════════
             SECTION 2 — Featured "Top Career Match" Card
             Overlaps the hero gradient slightly via negative margin.
             ════════════════════════════════════════════════════════════ -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTopMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_match_card"
                android:padding="20dp">

                <!-- Star emoji label -->
                <TextView
                    android:id="@+id/tvTopLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐  Top Career Match"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:alpha="0.9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Career name -->
                <TextView
                    android:id="@+id/tvTopMatchName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="AI Engineer"
                    app:layout_constraintEnd_toStartOf="@id/tvTopMatchScore"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTopLabel" />

                <!-- Match score -->
                <TextView
                    android:id="@+id/tvTopMatchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_score_badge"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="92%"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTopMatchName"
                    app:layout_constraintBottom_toBottomOf="@id/tvTopMatchName" />

                <!-- Short description -->
                <TextView
                    android:id="@+id/tvTopMatchDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.85"
                    android:fontFamily="sans-serif"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    tools:text="Design intelligent systems using machine learning and deep learning."
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTopMatchName" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════════════════════
             SECTION 3 — Quick Actions
             ════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="⚡  Quick Actions"
            android:textColor="@color/sc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- New Analysis -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNewAnalysis"
                    android:layout_width="130dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/sc_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/home_new_analysis"
                            android:textColor="@color/sc_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Saved Careers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSavedCareers"
                    android:layout_width="130dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/sc_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💾"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/home_saved_careers"
                            android:textColor="@color/sc_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- My Certifications -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCertifications"
                    android:layout_width="130dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="12dp"
                    app:cardBackgroundColor="@color/sc_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📜"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/home_my_certs"
                            android:textColor="@color/sc_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- My Progress -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgress"
                    android:layout_width="130dp"
                    android:layout_height="100dp"
                    app:cardBackgroundColor="@color/sc_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/home_my_progress"
                            android:textColor="@color/sc_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>

        <!-- ════════════════════════════════════════════════════════════
             SECTION 4 — Latest Career Suggestions
             ════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="🎯  Latest Career Suggestions"
            android:textColor="@color/sc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLatestCareers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- ════════════════════════════════════════════════════════════
             SECTION 5 — Saved Careers
             ════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="💾  Saved Careers"
            android:textColor="@color/sc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSavedCareers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- ════════════════════════════════════════════════════════════
             SECTION 6 — Certifications In Progress
             ════════════════════════════════════════════════════════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="📈  Certifications In Progress"
            android:textColor="@color/sc_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCertificationsProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>
</ScrollView>
