<?xml version="1.0" encoding="utf-8"?>
<!-- Hero section gradient: indigo → blue with rounded bottom corners.
     Creates a premium header backdrop for the welcome text. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="135"
        android:startColor="#6C63FF"
        android:centerColor="#5B6AE8"
        android:endColor="#4F6BED"
        android:type="linear" />

    <corners
        android:bottomLeftRadius="32dp"
        android:bottomRightRadius="32dp" />
</shape>
