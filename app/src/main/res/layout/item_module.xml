<?xml version="1.0" encoding="utf-8"?>


<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardModule"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/sc_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

       
        <ImageView
            android:id="@+id/ivLock"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/module_locked"
            android:padding="6dp"
            android:src="@drawable/ic_lock"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvModuleNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_module_number"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/sc_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_module_completed"
            android:contentDescription="@string/cert_detail_completed"
            android:padding="6dp"
            android:src="@android:drawable/checkbox_on_background"
            android:visibility="gone"
            app:tint="#27AE60"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvModuleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/sc_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Module 1: Introduction to ML"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/tvModuleNumber"
            app:layout_constraintTop_toTopOf="parent" />

     

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/sc_text_secondary"
            android:textSize="12sp"
            tools:text="⏱ 25 min"
            app:layout_constraintStart_toEndOf="@id/tvModuleNumber"
            app:layout_constraintTop_toBottomOf="@id/tvModuleTitle" />

       

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Start"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvQuizScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/sc_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Score: 100%"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
