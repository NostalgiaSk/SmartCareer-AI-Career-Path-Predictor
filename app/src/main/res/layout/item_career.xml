<?xml version="1.0" encoding="utf-8"?>


<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCareer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/sc_surface"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ── Match score badge (top-end corner) ────────────────── -->
        <TextView
            android:id="@+id/tvMatchScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_match_score_badge"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/sc_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="92 %"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ── Career name ───────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvCareerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/sc_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="AI Engineer"
            app:layout_constraintEnd_toStartOf="@id/tvMatchScore"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ── Short description (max 2 lines) ───────────────────── -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:maxLines="2"
            android:textColor="@color/sc_text_secondary"
            android:textSize="14sp"
            tools:text="Design and build intelligent systems using machine learning and deep learning frameworks."
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCareerName" />

        <!-- ── "View Skill Gap" action button ────────────────────── -->
        <Button
            android:id="@+id/btnViewSkillGap"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_button_ripple"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:text="@string/btn_view_skill_gap"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
