<?xml version="1.0" encoding="utf-8"?>
<!-- Selector for quiz answer options: normal / selected states -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected state -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#E8EAFF" />
            <stroke android:width="2dp" android:color="#4F6BED" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sc_surface" />
            <stroke android:width="1.5dp" android:color="#E5E7EB" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
