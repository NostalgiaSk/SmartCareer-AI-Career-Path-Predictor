<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartCareer">

        <!-- Login screen – the first screen users see -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main dashboard (launched after successful login) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Registration screen (launched from Login → Create Account) -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Career profile form (launched after login/register) -->
        <activity
            android:name=".CareerProfileActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- AI career suggestions list (launched after profile submission) -->
        <activity
            android:name=".CareerSuggestionsActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

        <!-- Skill gap detail screen (launched from a career card) -->
        <activity
            android:name=".SkillGapActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.SmartCareer" />

    </application>

</manifest>