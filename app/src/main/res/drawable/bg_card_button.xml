<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient shape for card action buttons: same indigo → blue brand gradient, pill-shaped -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="0"
        android:startColor="@color/sc_gradient_start"
        android:endColor="@color/sc_gradient_end"
        android:type="linear" />

    <corners android:radius="20dp" />

    <padding
        android:left="20dp"
        android:top="8dp"
        android:right="20dp"
        android:bottom="8dp" />
</shape>
